# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Session file name. It holds a full login to your account, so keep it private.
TG_SESSION=owner

# Offer command: type "<codeword> <t.me/nft link> <price in Stars>" in a private chat.
# The message is deleted and an offer is sent. Empty codeword = command disabled.
OFFER_CODEWORD=
# Hard cap for any single offer, so a typo can't spend too much.
OFFER_MAX_STARS=1000
# Offer lifetime in hours. Allowed: 6, 12, 24, 36, 48, 72.
OFFER_DURATION_HOURS=6

# Incoming offers: accept at or above this many Stars. Empty = never accept automatically.
OFFER_ACCEPT_MIN_STARS=
# Incoming offers: decline below this many Stars. Empty = never decline automatically.
# Must be <= OFFER_ACCEPT_MIN_STARS when both are set.
OFFER_DECLINE_BELOW_STARS=
